# Customer site — CONTROL_FLOW_AND_DATA_LOGIC.md §22.
# Copy to .env.local for development. Never commit real values.

# Salon API. /api/public/* on this site is rewritten here (next.config.ts).
# Local backend default port is 4000.
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Cloudflare Turnstile site key (T0.11). Public by design.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Razorpay key id for deposits / gift cards. Public by design; the secret
# lives only in backend/.env.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Shared with the backend; authorises POST /api/revalidate (T1.24).
REVALIDATE_SECRET=

# Rollback switch (CHECKPOINTS.md CP1): "whatsapp" turns every booking CTA
# into a WhatsApp link. "request" is the Phase 1 request-lite form.
NEXT_PUBLIC_BOOKING_MODE=request

# Canonical origin, used in metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://thexpertshair.com
# "1" ONLY on the production deployment on the real domain (T1.22). Anything
# else keeps the site out of search engines.
NEXT_PUBLIC_INDEXABLE=
# Domain switch (T1.23): set to https://app.thexpertshair.com when the staff app
# moves there, so old staff URLs on the apex redirect to it.
STAFF_APP_URL=
