{
  "version": 2,
  "regions": ["bom1"],
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/reviews-refresh",
      "schedule": "30 21 * * *"
    }
  ]
}
