# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ── Frontend URL ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hair-salon?retryWrites=true&w=majority

# ── Auth / Session ────────────────────────────────────────────────────────────
SESSION_SECRET=replace-with-a-long-random-hex-string
NODE_ENV=production

# ── Owner Account (auto-created/updated on server start) ─────────────────────
OWNER_EMAIL=owner@yourdomain.com
OWNER_PASSWORD=1234567


# ── Razorpay webhook ──────────────────────────────────────────────────────────
RAZORPAY_WEBHOOK_SECRET=replace-with-the-secret-set-in-the-razorpay-dashboard

# ── Customer website (CONTROL_FLOW_AND_DATA_LOGIC.md §22) ─────────────────────
# Cloudflare Turnstile secret (T0.11). Required in production — the request form
# is refused without it. For a staging copy use Cloudflare's always-pass test
# secret 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=
# Telegram bot that alerts the owner on new website requests (same bot as the
# login gate; owners link it under Management → Telegram).
TELEGRAM_BOT_TOKEN=
# Shared secret for scheduled jobs. The outside timer (cron-job.org) sends
# "Authorization: Bearer <CRON_SECRET>" to /api/cron/*. Any long random string.
CRON_SECRET=
# Customer website — instant updates after owner edits (T1.24). Same
# REVALIDATE_SECRET as the customer site's Vercel project.
CUSTOMER_SITE_URL=https://www.thexpertshair.com
REVALIDATE_SECRET=
# Google rating + reviews (T1.21). Key restricted to "Places API (New)".
# Place ID: `npm run find:place`, then here or in Website Settings.
GOOGLE_PLACES_API_KEY=
SALON_PLACE_ID=
# Photo/video uploads from the staff app (Vercel → Storage → Blob, free tier).
BLOB_READ_WRITE_TOKEN=

# Phase 2 online booking (CF §22)
# Signs booking tokens and manage links. Long random string; rotating it voids old links.
PUBLIC_TOKEN_SECRET=
# WhatsApp messages (CF §11, D52). Without credentials, codes/messages print to the
# console outside production.
# Who sends: "meta" (default, Meta's Cloud API below) or "aisensy" (AiSensy campaign API).
# The one-time code always goes through Meta, whichever is chosen.
WHATSAPP_PROVIDER=meta
# Who sends the one-time login code: "meta" (default) or "aisensy" (the `otp_code` campaign must be Live).
# Independent of WHATSAPP_PROVIDER, so the code can be moved, and moved back, on its own.
# The code ignores DRY_RUN and TEST_PHONE: a customer is always sent their own code.
OTP_PROVIDER=meta
# AiSensy API key — server-side only, never a NEXT_PUBLIC_ / VITE_ variable. Needed when WHATSAPP_PROVIDER=aisensy.
# Each message type is an AiSensy campaign of the same name (see PARAMS in utils/whatsapp.js) and must be Live.
AISENSY_KEY=
# SAFE BY DEFAULT. DRY_RUN=true sends nothing: messages are checked, logged and recorded as skipped.
# Set DRY_RUN=false only after you have seen one test message per template on your own phone.
# (Left unset: on for AiSensy, off for Meta.)
DRY_RUN=true
# While testing, every message goes to this number instead of the customer's (10-digit mobile).
# Leave blank for real customers. A value that is not a mobile number stops all sending.
TEST_PHONE=
# Meta Cloud API: developers.facebook.com → your app → WhatsApp → API setup.
# The token must be a permanent System User token (the 24h test token expires).
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
# Optional: META_WA_API_VERSION=v21.0, WHATSAPP_TEMPLATE_LANGUAGE=en
# Names of the templates approved in Meta's WhatsApp Manager — exact text to submit
# is in docs/customer-platform/WHATSAPP_TEMPLATES.md.
WHATSAPP_TEMPLATE_OTP=
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=
WHATSAPP_TEMPLATE_REQUEST_RECEIVED=
WHATSAPP_TEMPLATE_BOOKING_DECLINED=
WHATSAPP_TEMPLATE_REQUEST_DECLINED=
WHATSAPP_TEMPLATE_REQUEST_CANCELLED=
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=
WHATSAPP_TEMPLATE_BOOKING_REFUND=
WHATSAPP_TEMPLATE_BOOKING_MOVED=
WHATSAPP_TEMPLATE_BOOKING_ARTIST_CHANGED=
WHATSAPP_TEMPLATE_REMINDER_24H=
WHATSAPP_TEMPLATE_REMINDER_2H=
# 08:15 day sheet sent to each artist with bookings (D56)
WHATSAPP_TEMPLATE_ARTIST_DAY_SHEET=

# Meta Conversions API (CF §17, D65): Lead and Schedule sent from the server too, with the
# booking ref as event_id so Meta counts each once. Off while either value is empty.
# Pixel id = the website's NEXT_PUBLIC_META_PIXEL_ID. Token: Business settings → System
# users → "Conversions API System User" → assign the dataset → Generate token. Set ONLY on
# production, like the pixel, so test bookings never reach the ad account.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional: a code from Events Manager → Test events, to check events there before going live.
# Remove it afterwards: while it is set, events go to the test view, not live data.
META_CAPI_TEST_CODE=

# Instagram reels sync (CF §13, D58). Token from the Meta app: Instagram → API setup with
# Instagram login → Generate token. Seeds the stored token, which the app then renews itself.
INSTAGRAM_ACCESS_TOKEN=

# Counter UPI QR payments (D60). Off by default: the visit form keeps using Razorpay Checkout.
# Set true to make "UPI (QR)" show a QR on the paired tablet at /display (Management → Counter display).
# Needs the Razorpay webhook to deliver payment.captured (already required). Do NOT tick qr_code.* events.
COUNTER_DISPLAY_ENABLED=false

# ── Read an offer poster (staff app → Website → Offers → Bundles) ──
# Off until this is set. One AI request per poster (a few rupees); 20 reads per person per day.
# Get a key at console.anthropic.com. Optional: POSTER_READER_MODEL to change the model.
ANTHROPIC_API_KEY=
# Or use OpenAI for poster reading instead (used first when both keys are set; force one with
# POSTER_READER_PROVIDER=openai or anthropic). Optional: POSTER_READER_OPENAI_MODEL (default gpt-6.1-sol).
OPENAI_API_KEY=
